# Vorlage - so muss die echte secrets.toml aussehen (lokal unter .streamlit/secrets.toml,
# NICHT ins Git-Repo committen - steht deshalb in .gitignore).
#
# Bei Streamlit Community Cloud wird das nicht als Datei angelegt, sondern im
# Deploy-Menü unter "Settings -> Secrets" eingetragen (siehe ANLEITUNG_CLOUD.md).

DATABASE_URL = "postgresql://benutzer:passwort@host.neon.tech/lagersystem?sslmode=require"
